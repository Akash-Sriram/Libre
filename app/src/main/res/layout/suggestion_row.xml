<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <!-- Tonal Leading Icon Capsule -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/icon_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/leading_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_history"
            app:tint="?attr/colorOnSurfaceVariant" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/suggestion_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        tools:text="Search query suggestion" />

    <!-- Trailing Action: Delete for History -->
    <ImageView
        android:id="@+id/delete_history"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:tooltipText="@string/delete"
        android:visibility="gone"
        app:tint="?attr/colorOutline"
        tools:visibility="visible" />

    <!-- Trailing Action: Insert Arrow for Online Suggestions -->
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_hint"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_up_left"
        android:visibility="gone"
        app:tint="?attr/colorOutline"
        tools:visibility="visible" />

</LinearLayout>
