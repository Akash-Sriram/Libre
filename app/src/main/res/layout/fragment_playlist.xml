<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.PlaylistFragment">

    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/playlist_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlist_recView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="?attr/colorPrimary"
        android:scrollbarSize="4dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/playlist_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/playlist_collapsing_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll"
            app:titleCollapseMode="scale">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp">

                <!-- 1:1 Square Cover Art Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/thumbnail_card"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:srcCompat="@tools:sample/backgrounds/scenic[0]" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Centered Playlist Title -->
                <app.libre.ui.views.ExpandableTextView
                    android:id="@+id/playlist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Tamil Songs" />

                <!-- Centered Song Count & Duration Subtitle -->
                <TextView
                    android:id="@+id/playlistInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="1,667 songs • 128 hrs" />

                <TextView
                    android:id="@+id/playlist_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Action Controls: Play all, Shuffle, Bookmark, Sort, More -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/play_all"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:maxLines="1"
                        android:text="@string/play_all"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_playlist"
                        app:iconTint="?attr/colorOnPrimary"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shuffleBTN"
                        style="?materialButtonTonalStyle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:maxLines="1"
                        android:text="@string/shuffle"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_shuffle"
                        app:iconTint="?attr/colorPrimary"
                        app:iconSize="18dp" />



                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bookmark"
                        style="?materialIconButtonFilledTonalStyle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="@string/bookmark"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_bookmark_outlined"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorPrimary"
                        app:iconSize="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sortBTN"
                        style="?materialIconButtonFilledTonalStyle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="@string/tooltip_sort"
                        android:visibility="gone"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_swap_vert"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorPrimary"
                        app:iconSize="20dp"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/optionsMenu"
                        style="?materialIconButtonFilledTonalStyle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="@string/misc"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_more_vert"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnSurfaceVariant"
                        app:iconSize="20dp" />

                </LinearLayout>



                <LinearLayout
                    android:id="@+id/nothing_here"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="35dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_list" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/emptyList"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>


    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scrollToTopFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="@string/tooltip_scroll_to_top"
        android:visibility="gone"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_arrow_up"
        app:tint="?attr/colorOnPrimaryContainer"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>