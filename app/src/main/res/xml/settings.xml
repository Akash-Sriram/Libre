<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/storage_and_offline_sync">
        <Preference
            android:icon="@drawable/ic_download_folder"
            app:key="offline_songs_pref"
            app:title="@string/offline_songs_folder"
            app:summary="@string/offline_songs_folder_summary_not_set" />

        <Preference
            android:icon="@drawable/ic_refresh"
            app:key="rescan_offline_songs"
            app:title="@string/rescan_offline_audio"
            app:summary="@string/rescan_offline_audio_summary" />

        <Preference
            android:icon="@drawable/ic_device"
            app:key="wifi_sync_status"
            app:title="@string/wifi_sync_server"
            app:summary="@string/wifi_sync_stopped" />

        <Preference
            android:icon="@drawable/ic_backup"
            app:key="backup_folder"
            app:title="@string/backup_folder"
            app:summary="@string/backup_folder_summary_not_set" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_auto_backup"
            app:defaultValue="true"
            app:key="enable_auto_backup"
            app:title="@string/auto_backup_pref"
            app:summary="@string/auto_backup_summary" />

        <Preference
            android:icon="@drawable/ic_upload"
            app:key="backup_now"
            app:title="@string/create_backup_now"
            app:summary="@string/create_backup_now_summary" />

        <Preference
            android:icon="@drawable/ic_restore"
            app:key="restore"
            app:title="@string/restore"
            app:summary="@string/restore_backup_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/streaming_category">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_audio"
            android:summary="@string/auto_music_audio_mode_summary"
            android:title="@string/auto_music_audio_mode"
            app:key="auto_music_audio_mode" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/identify_music">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_mic"
            android:summary="@string/capture_google_sound_search_desc"
            android:title="@string/capture_google_sound_search_title"
            app:key="capture_google_song_notifications" />

        <Preference
            android:icon="@drawable/ic_share"
            app:key="open_supported_links"
            app:title="@string/open_supported_links_title"
            app:summary="@string/open_supported_links_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_category_system">
        <Preference
            android:icon="@drawable/ic_error"
            app:key="crash_logs"
            app:title="@string/crash_logs"
            app:summary="@string/crash_logs_summary" />

        <Preference
            android:icon="@drawable/ic_update"
            app:key="update"
            app:title="@string/update_summary" />
    </PreferenceCategory>

</PreferenceScreen>
